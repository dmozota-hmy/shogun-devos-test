{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "provider": {
    "tdai-memory": {
      "name": "TDAI Memory (proxy)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:8096/openclaw/default/v1",
        "apiKey": "{env:TDAI_USER_KEY}",
        "headers": {
          "x-team-id": "{env:TDAI_TEAM_ID}",
          "x-agent-id": "{env:TDAI_AGENT_ID}",
          "x-task-id": "{env:TDAI_TASK_ID}",
          "x-conversation-id": "{env:TDAI_CONVERSATION_ID}"
        }
      },
      "models": {
        "gpt-5.6-sol": {
          "name": "SOL - gpt-5.6 (critico, pocos tokens)"
        },
        "gpt-5.6-terra": {
          "name": "TERRA - gpt-5.6 (potencia media-alta)"
        },
        "gpt-5.6-luna": {
          "name": "LUNA - gpt-5.6 (ligero)"
        }
      }
    }
  }
}
