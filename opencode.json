{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "subagent_depth": 1,
  "instructions": [".opencode/pipeline/AGENT_OUTPUT_PROTOCOL.md"],
  "mcp": {
    "shogun-memory": {
      "type": "local",
      "command": ["node", ".opencode/mcp/shogun-memory.mjs"],
      "enabled": true,
      "cwd": ".",
      "timeout": 15000
    }
  },
  "permission": {
    "task": "allow",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "pwsh -NoProfile -File .opencode/pipeline/scripts/*": "allow",
      "pwsh -NoProfile -File .shogun/tools/*": "allow",
      "git push*": "ask",
      "git reset --hard*": "ask",
      "git clean*": "ask",
      "Remove-Item *": "deny",
      "Invoke-WebRequest *": "deny",
      "Invoke-Expression *": "deny",
      "npm install*": "ask",
      "pnpm install*": "ask",
      "yarn install*": "ask"
    }
  }
}
