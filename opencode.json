{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "subagent_depth": 1,
  "enabled_providers": ["github-copilot"],
  "instructions": [".opencode/pipeline/AGENT_OUTPUT_PROTOCOL.md"],
  "permission": {
    "task": "allow",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "pwsh -NoProfile -File .opencode/pipeline/scripts/*": "allow",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "Remove-Item *": "deny",
      "Invoke-WebRequest *": "deny",
      "Invoke-Expression *": "deny",
      "npm install*": "deny",
      "pnpm install*": "deny",
      "yarn install*": "deny"
    }
  }
}
