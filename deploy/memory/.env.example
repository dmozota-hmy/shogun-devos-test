# ─────────────────────────────────────────────────────────────────────────────
# TencentDB Agent Memory — entorno local (Docker Compose)
#   Uso: copiar a .env, rellenar los REPLACE_ME, ejecutar .\start.ps1
#
# Dos grupos de LLM independientes:
#   MEMORY_*   → memory-core + memory-hub (extracción L0-L3, wiki, skills)
#   PROXY_*    → proxy: upstream al que reenvía las peticiones del agente
# ─────────────────────────────────────────────────────────────────────────────

# ── Imágenes (Docker Hub público, multi-arch) ────────────────────────────────
MEMORY_CORE_IMAGE=agentmemory/memory-core:latest
MEMORY_HUB_IMAGE=agentmemory/memory-hub:latest
PROXY_IMAGE=agentmemory/memory-proxy:latest

# ── Grupo memory: LLM interno (puede ser un modelo barato) ──────────────────
MEMORY_LLM_BASE_URL=REPLACE_ME        # ej: https://api.deepseek.com/v1
MEMORY_LLM_API_KEY=REPLACE_ME
MEMORY_LLM_MODEL=REPLACE_ME           # ej: deepseek-chat
MEMORY_LLM_PROTOCOL=openai            # openai | anthropic

# ── Grupo proxy: upstream que sirve las peticiones del agente ───────────────
# El proxy reenvía el model id tal cual viene en la petición. Si se usa como
# transporte opcional de memoria, el upstream debe servir los IDs reales
# gpt-5.6-terra y gpt-5.6-luna.
PROXY_UPSTREAM_URL=REPLACE_ME         # ej: https://api.openai.com/v1
PROXY_UPSTREAM_API_KEY=REPLACE_ME
PROXY_UPSTREAM_MODEL=gpt-5.6-terra

# ── Puertos (cambiar si hay conflicto local) ────────────────────────────────
MEMORY_CORE_PORT=8420
PANEL_PORT=8125
KNOWLEDGE_PORT=8424
PROXY_PORT=8096

# ── Volúmenes de datos ───────────────────────────────────────────────────────
MEMORY_CORE_VOLUME=tdai-memory-core-data
PANEL_VOLUME=tdai-panel-data

# ── Credenciales internas del gateway ───────────────────────────────────────
# Dejar vacío para uso local (Bearer gate desactivado). No exponer puertos.
MEMORY_CORE_GATEWAY_API_KEY=
MEMORY_CORE_ADMIN_USERNAME=admin

# ── opencode (solo si se activa el proxy opcional) ──────────────────────────
# TDAI_USER_KEY: user_key del usuario (panel → API Key). En local se puede
#   usar la admin key que genera start.ps1 en ./.admin-key.
# TDAI_TEAM_ID / TDAI_AGENT_ID / TDAI_TASK_ID: creados en el panel
#   (Team → Agent → Task). El proxy registra la sesión con estos ids.
# TDAI_CONVERSATION_ID: identificador de sesión de memoria. Cambiarlo por
#   conversación si se quiere separar contextos.
TDAI_USER_KEY=REPLACE_ME
TDAI_TEAM_ID=REPLACE_ME
TDAI_AGENT_ID=REPLACE_ME
TDAI_TASK_ID=REPLACE_ME
TDAI_CONVERSATION_ID=default
